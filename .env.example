# Is file ko copy karke `.env` naam do aur apni keys daalo. (.env ko kabhi GitHub par mat daalna)

# --- Tavily (live web search): https://app.tavily.com ---
TAVILY_API_KEY=tvly-your-key-here

# --- Groq (LLM): https://console.groq.com ---  (Bifrost ke andar bhi yahi key add hoti hai)
GROQ_API_KEY=gsk_your-key-here

# --- Bifrost gateway (http://localhost:8080 -> Governance -> Virtual Keys) ---
BIFROST_VK=sk-bf-your-virtual-key-here
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=bifrost
GATEWAY_NAME=Bifrost
MODEL=groq/openai/gpt-oss-120b
COMPARE_MODELS=groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b

# --- Optional ---
# RECENCY_PROBE=0     # disables the extra update-oriented search; fewer search requests, no accuracy guarantee either way
# FC_MIN_CHARS=40     # itne se chhote answers sidecar mein check nahi hote
